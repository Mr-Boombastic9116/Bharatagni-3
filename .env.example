# ==============================================================================
# BharatAgri Iteration 3 - Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT COMMIT REAL CREDENTIALS OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Metadata
PROJECT_NAME="BharatAgri Iteration 3 API"
PORT=5000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Database engine type: 'sqlite' (default for Render prototype) or 'mysql'
DB_TYPE=sqlite

# SQLite Configuration (Used when DB_TYPE=sqlite)
# Relative to repository root or absolute path
SQLITE_DATABASE_PATH=database/bharatagri.db

# File Upload Storage Path
EVIDENCE_UPLOAD_DIR=backend/uploads/evidence

# MySQL / MariaDB Configuration (Used when DB_TYPE=mysql)
# Method A: Discrete Connection Variables (Local XAMPP & Standard Hosting)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bharatagri_iteration2

# Method B: Direct Connection URL (Render external DB, TiDB, Aiven, AWS RDS)
# If set, DATABASE_URL overrides discrete variables when DB_TYPE=mysql.
# DATABASE_URL=mysql+pymysql://db_user:db_password@db_host:3306/bharatagri_iteration2?charset=utf8mb4

# SSL / TLS Configuration (MySQL only)
DB_SSL_DISABLED=false
# DB_SSL_CA=/path/to/ca-certificate.crt

# ------------------------------------------------------------------------------
# JWT Authentication & Security Settings
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret in production using: openssl rand -hex 32
SECRET_KEY=your_secure_jwt_random_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g., https://your-app.onrender.com)
# Set to '*' to allow all origins in prototyping environments
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# ------------------------------------------------------------------------------
# Frontend Configuration (When hosting Frontend independently)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://your-backend-api.onrender.com/api
